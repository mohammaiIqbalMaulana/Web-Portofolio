# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL="mysql://root:@127.0.0.1:3306/namadb_anda"

# =================================
# JWT CONFIGURATION
# =================================
JWT_SECRET="isi jwt anda disini"
JWT_EXPIRES_IN="gatau"

# =================================  
# APP CONFIGURATION
# =================================
NODE_ENV="development"
PORT=4000

# =================================
# CORS & FRONTEND
# =================================
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# =================================
# FILE UPLOAD
# =================================
UPLOAD_PATH="uploads/"
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp"

# =================================
# SECURITY
# =================================
BCRYPT_ROUNDS=silahkansendiri
RATE_LIMIT_WINDOW=silahkansendiri
RATE_LIMIT_MAX=silahkansendiri